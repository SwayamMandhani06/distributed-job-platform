# ===========================================================================
# Distributed Job Platform — Environment Configuration Example
# Copy this file to .env to override defaults for your environment.
# Never commit credentials or secrets to version control.
# ===========================================================================

# ---------------------------------------------------------------------------
# Database Settings (Dual-Backend: PostgreSQL authoritative / SQLite fallback)
# ---------------------------------------------------------------------------
# PostgreSQL connection DSN for multi-container Docker cluster:
# Format: postgresql://<username>:<password>@<host>:<port>/<database_name>
DATABASE_URL=postgresql://postgres:postgres_password_placeholder@localhost:5432/job_platform
POSTGRES_CONNECT_TIMEOUT_SECONDS=10.0

# Optional PostgreSQL credentials for docker-compose.yml:
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_password_placeholder
POSTGRES_DB=job_platform

# SQLite fallback settings (Active ONLY when DATABASE_URL is empty or unset):
JOB_PLATFORM_DB_NAME=job_platform.db
SQLITE_TIMEOUT_SECONDS=30.0

# ---------------------------------------------------------------------------
# Scheduler Service Settings
# ---------------------------------------------------------------------------
# Network host and port for the FastAPI Scheduler service.
SCHEDULER_HOST=localhost
SCHEDULER_PORT=8000

# Worker failure detector intervals (seconds).
# STALENESS_CHECK_INTERVAL_SECONDS: How often the Scheduler runs the staleness check loop.
# WORKER_STALENESS_TIMEOUT_SECONDS: Silence duration after which a worker is marked 'offline'.
STALENESS_CHECK_INTERVAL_SECONDS=5.0
WORKER_STALENESS_TIMEOUT_SECONDS=15.0

# ---------------------------------------------------------------------------
# Worker Service Settings
# ---------------------------------------------------------------------------
# Process / container worker identity (defaults to random UUID if omitted)
WORKER_ID=worker-1

# Port for the legacy HTTP worker service (Stage 1/2 RPC reference).
WORKER_HTTP_PORT=8001

# Worker liveness heartbeat interval (seconds) delivered by background thread.
HEARTBEAT_INTERVAL_SECONDS=5.0

# Simulated execution time per job (seconds).
SIMULATED_JOB_DURATION_SECONDS=2.0

# ---------------------------------------------------------------------------
# Message Queue & Durability Settings (Redis)
# ---------------------------------------------------------------------------
# Connection parameters for the Redis message broker.
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# Redis list key name for job dispatch and reliable processing queue.
QUEUE_NAME=job_queue
PROCESSING_QUEUE_NAME=job_queue:processing

# BRPOP blocking pop timeout (seconds).
REDIS_BRPOP_TIMEOUT_SECONDS=5

# At-least-once delivery: lease timeout (seconds) before a claimed job is marked stale.
JOB_LEASE_TIMEOUT_SECONDS=30.0

# Maximum total execution attempts (1 initial + up to MAX_JOB_RETRIES - 1 retries) before 'dead_letter'.
MAX_JOB_RETRIES=3

# Staleness checker interval for recovering abandoned jobs (seconds).
STALE_JOB_CHECK_INTERVAL_SECONDS=5.0
RETRY_DELAY_SECONDS=5.0

# ---------------------------------------------------------------------------
# Dashboard UI Settings
# ---------------------------------------------------------------------------
# Polling interval (milliseconds) for the single-page dashboard.
DASHBOARD_POLL_INTERVAL_MS=2000

# Number of recent jobs to return in the dashboard API payload.
DASHBOARD_RECENT_JOBS_LIMIT=15

# ---------------------------------------------------------------------------
# Scheduler Leadership & Fencing Settings (Unit III — Leader Leases)
# ---------------------------------------------------------------------------
# Unique node identifier for the scheduler process.
SCHEDULER_ID=scheduler-1

# Redis keys for distributed leader lease and monotonically increasing fencing epoch.
LEADER_LEASE_KEY=scheduler:leader:lease
LEADER_EPOCH_KEY=scheduler:leader:epoch

# Lease expiration TTL and periodic renewal heartbeat interval (seconds).
LEADER_LEASE_TTL_SECONDS=6.0
LEADER_RENEWAL_INTERVAL_SECONDS=2.0

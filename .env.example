# ===========================================================================
# Distributed Job Platform — Environment Configuration Example
# Copy this file to .env to override defaults for your environment.
# ===========================================================================

# ---------------------------------------------------------------------------
# Database Settings
# ---------------------------------------------------------------------------
# SQLite database filename stored in the project root directory.
JOB_PLATFORM_DB_NAME=job_platform.db

# ---------------------------------------------------------------------------
# Scheduler Service Settings
# ---------------------------------------------------------------------------
# Network host and port for the FastAPI Scheduler service.
SCHEDULER_HOST=localhost
SCHEDULER_PORT=8000

# Worker failure detector intervals (seconds).
# STALENESS_CHECK_INTERVAL_SECONDS: How often the Scheduler runs the staleness check loop.
# WORKER_STALENESS_TIMEOUT_SECONDS: Silence duration after which a worker is marked 'offline'.
STALENESS_CHECK_INTERVAL_SECONDS=5.0
WORKER_STALENESS_TIMEOUT_SECONDS=15.0

# ---------------------------------------------------------------------------
# Worker Service Settings
# ---------------------------------------------------------------------------
# Port for the legacy HTTP worker service (Stage 1/2 RPC reference).
WORKER_HTTP_PORT=8001

# Worker liveness heartbeat interval (seconds) delivered by background thread.
HEARTBEAT_INTERVAL_SECONDS=5.0

# Simulated execution time per job (seconds).
SIMULATED_JOB_DURATION_SECONDS=2.0

# ---------------------------------------------------------------------------
# Message Queue Settings (Redis)
# ---------------------------------------------------------------------------
# Connection parameters for the Redis message broker.
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# Redis list key name for job dispatch.
QUEUE_NAME=job_queue

# BRPOP blocking pop timeout (seconds).
REDIS_BRPOP_TIMEOUT_SECONDS=5

# ---------------------------------------------------------------------------
# Dashboard UI Settings
# ---------------------------------------------------------------------------
# Polling interval (milliseconds) for the single-page dashboard.
DASHBOARD_POLL_INTERVAL_MS=2000

# Number of recent jobs to return in the dashboard API payload.
DASHBOARD_RECENT_JOBS_LIMIT=15
